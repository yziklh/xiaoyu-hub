{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "教室小助手",
  "version": "1.0.1",
  "identifier": "classroom-agent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "教室小助手",
        "width": 800,
        "height": 600,
        "resizable": true,
        "maximizable": false,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "shadow": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DOCUMENT/FishHub/**",
          "$APPDATA/classroom-agent/**",
          "$HOME/Documents/FishHub/**"
        ]
      },
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost http://localhost:8098 ws://localhost:8098 http:// https: ws: wss:",
        "font-src": "'self'",
        "img-src": "'self' asset: http://asset.localhost blob: data: http: https:",
        "style-src": "'unsafe-inline' 'self'",
        "script-src": "'self' 'unsafe-inline' http://localhost:8098"
      }
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhGRDIzMEUzMkQ4MkE5RjUKUldUMXFZSXQ0ekRTanplKzVGYlllVktRNmNEbmd6UVhxK3RrZGIzU0JHV2NoSmFPWGRJemUrK1oK"
    }
  }
}
